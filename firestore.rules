rules_version = '2';
// 📒 آڑھت بک — فائربیس کے حفاظتی اصول
// ہر آڑھت کا ڈیٹا shops/<کوڈ>/… میں؛ صرف اسی آڑھت کے جڑے آلات (members) پڑھ/لکھ سکیں۔
// آڑھت کا کوڈ لمبا اور بے ترتیب ہوتا ہے؛ آڑھتوں کی فہرست کوئی نہیں دیکھ سکتا۔
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function shop(id) { return get(/databases/$(db)/documents/shops/$(id)).data; }
    function isOwner(id) { return signedIn() && shop(id).owner == request.auth.uid; }
    function isMember(id) { return signedIn() && exists(/databases/$(db)/documents/shops/$(id)/members/$(request.auth.uid)); }

    match /shops/{shopId} {
      // نیا آڑھت: بنانے والا ہی مالک
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid;
      allow get: if isMember(shopId);
      // بدلنا صرف مالک؛ یا جڑا ہوا آلہ جس نے مالک کا خفیہ کوڈ دیا ہو (مالک کا نیا آلہ) — صرف owner بدلے، خود کو
      allow update: if isOwner(shopId) || (
        isMember(shopId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owner']) &&
        request.resource.data.owner == request.auth.uid &&
        exists(/databases/$(db)/documents/shops/$(shopId)/claims/$(request.auth.uid)) &&
        get(/databases/$(db)/documents/shops/$(shopId)/claims/$(request.auth.uid)).data.key ==
          get(/databases/$(db)/documents/shops/$(shopId)/secret/owner).data.key);
      allow list, delete: if false;

      // مالک کا خفیہ کوڈ دینے کی جگہ — کوئی پڑھ نہیں سکتا، ہر آلہ صرف اپنی
      match /claims/{uid} {
        allow create, update: if signedIn() && uid == request.auth.uid;
        allow read, delete: if false;
      }

      // جڑے آلات: مالک خود، یا ملازم جو آڑھت کا جوڑنے والا کوڈ جانتا ہو
      match /members/{uid} {
        allow read: if isMember(shopId);
        allow create: if signedIn() && uid == request.auth.uid && (
          shop(shopId).owner == request.auth.uid ||
          request.resource.data.key == get(/databases/$(db)/documents/shops/$(shopId)/secret/join).data.key);
        allow update, delete: if isOwner(shopId);
      }
      // جوڑنے والا کوڈ صرف مالک دیکھے/بدلے
      match /secret/{doc} {
        allow read, write: if isOwner(shopId);
      }
      // ریکارڈ (پرچیاں، کھاتے، وصولی، خرچے…) — ہر ریکارڈ الگ دستاویز
      match /records/{rid} {
        allow read, write: if isMember(shopId);
      }
    }

    // ---------- سبسکرپشن (license.js) — لکھنا صرف ڈویلپر (ای میل/پاس ورڈ والی شناخت) ----------
    function isDev() {
      return signedIn() && request.auth.token.email == 'piarybhai@gmail.com' &&
        request.auth.token.firebase.sign_in_provider == 'password';
    }
    // مفت آزمائش کی شروع کی تاریخ — موبائل نمبر پر ایک بار؛ دوبارہ انسٹال سے نئی نہیں ہوتی
    match /trials/{phone} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['at']) &&
        request.resource.data.at is timestamp &&
        request.resource.data.at > request.time - duration.value(10, 'm') &&
        request.resource.data.at < request.time + duration.value(10, 'm');
      allow update, delete, list: if isDev();
    }
    // موبائل نمبر کی سبسکرپشن کب تک (نیا فون / دوبارہ انسٹال پر بحالی)
    match /subs/{phone} {
      allow get: if signedIn();
      allow list, write: if isDev();
    }
    // ایکٹیویشن کوڈ: ایپ صرف کوڈ جان کر پڑھ سکے
    match /licenses/{code} {
      allow get: if signedIn();
      allow list, write: if isDev();
    }

    // باقی سب بند
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
